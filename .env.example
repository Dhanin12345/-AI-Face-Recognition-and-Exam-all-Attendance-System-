# Email Configuration for Django (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Enter your Gmail address here
EMAIL_HOST_USER=your_email@gmail.com

# Enter your 16-character Google App Password here (Do not use your regular password)
# To generate one:
# 1. Go to your Google Account Settings -> Security.
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App Passwords" or go to: https://myaccount.google.com/apppasswords
# 4. Generate a new app password for 'Mail' / 'Other' and paste the 16-character code below without spaces.
EMAIL_HOST_PASSWORD=your_16_character_app_password

# Optional: Default sender email (defaults to EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Twilio SMS Configuration (Optional - for sending real text messages to phones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alternative SMS Configuration (Optional - Fast2SMS gateway for India)
FAST2SMS_API_KEY=
